{
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!assets/|manus-storage/|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
